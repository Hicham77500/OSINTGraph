# OSINTGraph — Docker / NAS production environment
# Copy to .env at repo root: cp .env.docker.example .env

# Port exposed by the web (nginx) container on the host
OSINTGRAPH_PORT=8080

# SQLite database path inside the api container (do not change unless you adjust the volume mount)
SQLITE_PATH=/data/osintgraph.db

# Comma-separated origins allowed for CORS and Socket.IO (use your NAS URL or Tailscale hostname)
CORS_ORIGINS=http://localhost,http://192.168.1.100:8080,https://nas.tailnet-name.ts.net

# Authentication — set to false for production
OSINTGRAPH_AUTH_DISABLED=false

# Session token sent as X-OSINTGraph-Session header when auth is enabled
# Generate a long random string: openssl rand -hex 32
OSINTGRAPH_SESSION_SECRET=change-me-in-production

# Transform rate limit (requests per minute per client IP)
TRANSFORM_RATE_LIMIT=30

# AI analysis readiness threshold (0–100)
AI_READINESS_THRESHOLD=60

# AI provider: rule-based (default) or external when configured
AI_PROVIDER=rule-based
AI_API_KEY=

# Optional OSINT API keys (transforms degrade gracefully without them)
SHODAN_API_KEY=
HIBP_API_KEY=
