# OSINTGraph — variables Docker / déploiement VPS
# Copier vers .env : cp .env.example .env

# Ports exposés sur la machine hôte
API_PORT=8000
FRONTEND_PORT=8080
SPIDERFOOT_PORT=5001

# Frontend : laisser vide pour proxy nginx same-origin (recommandé en Docker)
VITE_API_BASE=

# Origines autorisées (CORS + Socket.IO)
CORS_ORIGINS=http://localhost:8080,http://localhost

# Base SQLite (volume Docker api → /app/data)
SQLITE_PATH=/app/data/osintgraph.db

# SpiderFoot optionnel (profil compose : --profile spiderfoot)
# Le plugin spiderfoot_scan utilise des modules passifs par défaut.
SPIDERFOOT_URL=http://spiderfoot:5001

# Clés API optionnelles
SHODAN_API_KEY=
HIBP_API_KEY=

# Auth — désactivée par défaut en dev/Docker local
OSINTGRAPH_AUTH_DISABLED=true
OSINTGRAPH_SESSION_SECRET=change-me-in-production
TRANSFORM_RATE_LIMIT=30
