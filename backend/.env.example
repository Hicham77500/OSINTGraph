NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
SHODAN_API_KEY=your_key_here
HIBP_API_KEY=your_key_here
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
IPINFO_API_KEY=
BRAVE_SEARCH_API_KEY=

# URL publique HTTPS de l'API (recherche image par URL)
# OSINTGRAPH_PUBLIC_API_URL=https://osintgraph.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SQLITE_PATH=osintgraph.db
OSINTGRAPH_AUTH_DISABLED=true
OSINTGRAPH_SESSION_SECRET=change-me-in-production
TRANSFORM_RATE_LIMIT=30
AI_READINESS_THRESHOLD=60
AI_PROVIDER=rule-based
AI_API_KEY=

# Recherche décès INSEE (data.gouv.fr) — voir https://github.com/sosoj92/arbre-local
# Chemin local : fichier .parquet ou dossier parts/ partitionné
# DEATH_RECORDS_PATH=/chemin/vers/parts
# URL CDN (requêtes HTTP Range, format arbre-local)
# DEATH_RECORDS_BASE_URL=https://pub-xxxxx.r2.dev/parts
