{
  "name": "osintgraph",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -File scripts/setup.ps1':'bash scripts/setup.sh',{stdio:'inherit'})\"",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:stop": "node scripts/dev-stop.cjs",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && (.venv\\Scripts\\python -m uvicorn main:asgi_app --reload --port 8000 2>nul || .venv/bin/python -m uvicorn main:asgi_app --reload --port 8000 || python -m uvicorn main:asgi_app --reload --port 8000)",
    "dev:streamlit": "streamlit run streamlit_app.py",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
